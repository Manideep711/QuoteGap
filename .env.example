# Browser-only development needs no environment variables or API keys.
# To use the same-origin API, build with VITE_API_URL=.
# VITE_API_URL=.

# Set the following on the SERVER in Render, never in browser VITE variables.
# RENDER_API_KEY=
# RENDER_TASK_SLUG=your-workflow-slug/compare-project
# API_ACCESS_TOKEN=
# PORT=3001

# This file is documentation; production secrets belong in Render's dashboard.
